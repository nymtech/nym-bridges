[Unit]
Description=nym-bridge daemon
Documentation=man:nym-bridge(1)

# Make sure the network is online before this starts (public IP detection may need it)
Wants=network-online.target
After=network-online.target NetworkManager.service systemd-resolved.service

# Restart after a failed exit (non-zero status, crash), never after a deliberate stop. Give up after
# 5 starts in 300 s so a persistently broken config shows as failed instead of flapping; clear it
# with `systemctl reset-failed nym-bridge`.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
# Before starting, refresh the public IPs / client params (see `public_ips_source` in the config),
# make the config and keys readable by the service group, and open firewall ports matching the
# configured transports; close the ports after stopping. The `+` prefix runs these as root outside
# the sandbox below; `-` makes failures non-fatal so a problem in any of these steps never prevents
# the bridge from running with its existing config.
ExecStartPre=-+/usr/lib/nym-bridge/prestart /etc/nym/bridges.toml
ExecStart=/usr/bin/nym-bridge --config /etc/nym/bridges.toml
ExecStopPost=-+/usr/lib/nym-bridge/firewall-sync close
Type=exec
Restart=on-failure
RestartSec=5
User=nym
Group=nym
# One socket per amnezia session (default cap 10000), matching service/nym-bridge.service
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# system execution protections / limitations
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes

# executable access limitations
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nym/
RestrictRealtime=yes
StateDirectory=nym
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target