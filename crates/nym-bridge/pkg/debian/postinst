#!/bin/sh
set -e

BRIDGES_CONF_DIR="/etc/nym/"
BRIDGES_CONF="${BRIDGES_CONF_DIR}bridges.toml"
BRIDGES_HOME="/var/lib/nym/"
BRIDGES_USER="nym"
BRIDGES_FIX_PERMISSIONS="/usr/lib/nym-bridge/fix-permissions"
BRIDGES_FIREWALL_SYNC="/usr/lib/nym-bridge/firewall-sync"
BRIDGES_FIREWALL_STATE="/var/lib/nym/bridge-firewall.ports"

create_user() {
    if id ${BRIDGES_USER} > /dev/null 2>&1; then return; fi
    adduser --system --home "${BRIDGES_HOME}" --group ${BRIDGES_USER}
    
    # Ensure home directory exists with correct permissions
    mkdir -p "${BRIDGES_HOME}"
    chown ${BRIDGES_USER}:${BRIDGES_USER} "${BRIDGES_HOME}"
}

create_first_time_configuration() {
    if [ ! -f "${BRIDGES_CONF}" ]; then
        # Ensure config directory exists
        mkdir -p "${BRIDGES_CONF_DIR}"
        
        # Created root-only; access for the service group is granted by fix_permissions
        mkdir -p -m 700 "${BRIDGES_CONF_DIR}keys"

        # generate a config file using the default filesystem locations
        echo "Generating bridge configuration..."
        if ! bridge-cfg --gen 2>&1; then
            echo ""
            echo "================================================================"
            echo "WARNING: Bridge configuration generation failed"
            echo "================================================================"
            echo ""
            echo "Possible reasons:"
            echo "  1. Multiple nym-node configurations detected"
            echo "  2. No nym-node configuration found"
            echo "  3. Public IP detection failed"
            echo ""
            echo "To resolve this, run bridge-cfg manually:"
            echo ""
            echo "If you have multiple nym-node configs, specify which one:"
            echo "  bridge-cfg --id <node-id> --gen"
            echo ""
            echo "Or specify the config path directly:"
            echo "  bridge-cfg --node-config /path/to/nym-node/config.toml --gen"
            echo ""
            echo "Example:"
            echo "  bridge-cfg --id my-node-name --gen"
            echo ""
            echo "After running bridge-cfg successfully:"
            echo "  systemctl enable nym-bridge"
            echo "  systemctl start nym-bridge"
            echo "================================================================"
            return 0
        fi

        echo ""
        echo "================================================================"
        echo "SUCCESS: Bridge configuration created"
        echo "================================================================"
        echo ""
        echo "SECURITY NOTICE:"
        echo "Config file created at: ${BRIDGES_CONF} (root:${BRIDGES_USER}, mode 640)"
        echo "Keys created in: ${BRIDGES_CONF_DIR}keys (root:${BRIDGES_USER}, mode 750/640)"
        echo "These permissions are re-applied every time nym-bridge starts."
        echo ""
        echo "To start the bridge:"
        echo "  systemctl enable nym-bridge"
        echo "  systemctl start nym-bridge"
        echo "================================================================"
    fi
}

fix_permissions() {
    # Make the config and keys readable, but not writable, by the service user: root:nym with
    # modes 640 (files) / 750 (keys directory). Also migrates configs from releases that made them
    # owned by nym, and fixes up files created by running `bridge-cfg` manually as root. The same
    # step runs every time the service starts.
    "${BRIDGES_FIX_PERMISSIONS}" "${BRIDGES_CONF}" "${BRIDGES_USER}" || true
}

remove_legacy_firewall_rules() {
    # Releases prior to firewall-sync unconditionally opened 4443/udp from this script. If
    # firewall-sync has never run (no state file) remove that rule so that it is not left open
    # after the configured ports change.
    if [ -f "${BRIDGES_FIREWALL_STATE}" ]; then return; fi

    if command -v ufw >/dev/null 2>&1 && ufw status >/dev/null 2>&1; then
        ufw delete allow 4443/udp >/dev/null 2>&1 || true
    elif command -v firewall-cmd >/dev/null 2>&1; then
        firewall-cmd --permanent --remove-port=4443/udp >/dev/null 2>&1 || true
        firewall-cmd --reload >/dev/null 2>&1 || true
    elif command -v iptables >/dev/null 2>&1; then
        iptables -D INPUT -p udp --dport 4443 -j ACCEPT 2>/dev/null || true
    fi
}

configure_firewall() {
    # Firewall rules follow the listen ports in the bridge config. They are (re)applied every time
    # the nym-bridge service starts, so edits to the config take effect on `systemctl restart
    # nym-bridge`. Apply them now as well so the ports are open as soon as the package is installed.
    if [ -f "${BRIDGES_CONF}" ]; then
        "${BRIDGES_FIREWALL_SYNC}" open "${BRIDGES_CONF}" || true
    fi
}

case "$1" in
configure)
    create_user
    create_first_time_configuration
    fix_permissions
    if [ -n "$2" ]; then
        remove_legacy_firewall_rules
    fi
    configure_firewall
    ;;
esac

#DEBHELPER#